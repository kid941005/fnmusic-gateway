# fnmusic-gateway 单镜像部署变量；复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# 只列 compose 会透传的启动变量；缓存/转码/歌词/音质/在线音源等运行参数可直接在网页 /settings 里改，
# 保存后写入 data/config.json 并立即生效，无需重启容器。

# ---- 镜像 ----
GW_IMAGE=ghcr.io/kid941005/fnmusic-gateway:latest

# ---- 必填 ----
# 管理接口 / MCP / WebUI 的令牌：openssl rand -hex 24
GW_ADMIN_TOKEN=

# ---- 飞牛音乐（可选，优先级最高；也可启动后在网页「设置」里填）----
GW_FNOS_BASE=
GW_FNOS_USER=
GW_FNOS_PASS=

# ---- 在线音源（musicdl，内置；首次启动默认值，网页可改）----
GW_ONLINE_ENABLED=true
GW_ONLINE_PLATFORMS=KuwoMusicClient,MiguMusicClient
GW_ONLINE_SEARCH_LIMIT=10
GW_ONLINE_TIMEOUT=25
GW_ONLINE_TOTAL_LIMIT=50
GW_ONLINE_TOTAL_TIMEOUT=40

# 本地下载目录在宿主机的位置（容器内固定 /music）
GW_MUSIC_DIR=./music

# ---- 音质默认值（首次启动；之后可在网页 /settings 改）----
# 在线试听/播放音质
GW_QUALITY_DEFAULT=standard
# 下载/自动补齐/边播边存音质；lossless 保留原始文件
GW_DOWNLOAD_QUALITY=lossless

# ---- 下载完成后触发飞牛扫描（默认自动，无需配置）----
# 默认复用「设置 → 飞牛音乐」的地址/账号/令牌调用官方扫库接口。
# 以下仅用于非飞牛环境或内置扫库失败时的自定义兜底，留空即可。
# GW_LIBRARY_SCAN_CMD=curl -fsS -X POST http://192.168.1.10:5666/api/...
# GW_LIBRARY_SCAN_URL=http://192.168.1.10:5666/api/...

# ---- 设备直链前缀（使用 MCP 接入点桥接时必填）----
# 必须是设备能访问的网关地址；留空时直连设备会按请求 Host 推导，但桥接器场景会拿到容器内地址。
GW_PUBLIC_BASE=

# ---- 小智 MCP 接入点（仅用桥接器时填；不用留空）----
MCP_ENDPOINT=

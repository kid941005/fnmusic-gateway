# fnmusic-gateway 单端口部署变量示例；复制为 .env 后按需填写。
# cp .env.example .env && chmod 600 .env

# ---- 镜像 ----
GW_IMAGE=ghcr.io/kid941005/fnmusic-gateway:2.3.0
# 默认轻量 WebUI 镜像（musicdl + WebUI）；需要网易/洛雪改成 :latest 全量镜像
FNMUSIC_SOURCES_IMAGE=ghcr.io/kid941005/fnos_music_ext:musicdl-webui

# ---- 网关（只发布 8766）----
# 设备/公网可访问的地址；留空按请求 Host 推导（Lucky 反代通常不用填）
GW_PUBLIC_BASE=
# 必填：管理接口、MCP、WebUI 的管理令牌（openssl rand -hex 24）
GW_ADMIN_TOKEN=
# WebUI 反代目标；compose 默认指向音源容器内部 8004
GW_WEBUI_URL=http://fnmusic-sources:8004
GW_WEBUI_TIMEOUT=30
# 空=自动生成 /data/sign.key
GW_SIGN_SECRET=
GW_QUALITY_DEFAULT=standard
GW_TEE_SAVE=true
GW_LIBRARY_MAX_BYTES=0
# 网关转发到官方 MCPServer 内部回环服务的超时（秒）
GW_MCP_TIMEOUT=300
# 本地曲库的宿主机目录（容器内固定 /vol1/1000/Music）
GW_MUSIC_DIR=./music

# ---- 飞牛音乐账号 ----
FNMUSIC_BASE=http://192.168.50.100:59820
FNMUSIC_USER=KID
FNMUSIC_PASS=
FNMUSIC_DEVICE_ID=
# 仅在飞牛使用自签 HTTPS 时设为 1（默认校验证书）
FNMUSIC_INSECURE_TLS=

# ---- 多音源兜底 ----
# 类型@地址；单端口 compose 内部用 fnmusic-sources:8001
GW_FALLBACK_URLS=musicdl@http://fnmusic-sources:8001
# 在线歌曲保存到本地曲库的容器内目录（与 compose 挂载的右侧一致）
GW_DOWNLOAD_DIR=/vol1/1000/Music
# 下载后触发飞牛扫描的命令，可留空
GW_LIBRARY_SCAN_CMD=
# 所有在线源合并后的总结果上限与总超时预算（秒）
GW_FALLBACK_TOTAL_LIMIT=50
GW_FALLBACK_TOTAL_TIMEOUT=15

# ---- 小智 MCP 接入点（桥接器用；不用桥接器可留空）----
MCP_ENDPOINT=

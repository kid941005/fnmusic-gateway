# fnmusic-gateway 单镜像部署变量；复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# 只列 compose 会透传的启动变量；缓存/转码/歌词/音质/在线音源等运行参数可直接在网页 /settings 里改，
# 保存后写入 data/config.json 并立即生效，无需重启容器。

# ---- 镜像 ----
GW_IMAGE=ghcr.io/kid941005/fnmusic-gateway:2.8.0

# ---- 必填 ----
# 管理接口 / MCP / WebUI 的令牌：openssl rand -hex 24
GW_ADMIN_TOKEN=

# ---- 飞牛音乐（可选，优先级最高；也可启动后在网页「设置」里填）----
GW_FNOS_BASE=
GW_FNOS_USER=
GW_FNOS_PASS=

# ---- 在线音源（musicdl，内置；首次启动默认值，网页可改）----
GW_ONLINE_ENABLED=true
GW_ONLINE_PLATFORMS=KuwoMusicClient,MiguMusicClient
GW_ONLINE_SEARCH_LIMIT=10
GW_ONLINE_TIMEOUT=25
GW_ONLINE_TOTAL_LIMIT=50
GW_ONLINE_TOTAL_TIMEOUT=40

# 本地下载目录在宿主机的位置（容器内固定 /music）
GW_MUSIC_DIR=./music

# ---- 小智 MCP 接入点（仅用桥接器时填；不用留空）----
MCP_ENDPOINT=

# glibc 版（ffmpeg 7.x，镜像约 805 MB：Debian 的 ffmpeg 会拖进 mesa/llvm）
#   docker build -f Dockerfile.debian -t fnmusic-gateway:debian .
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY app.py fnmusic_client.py ./
COPY gwlib/ ./gwlib/
COPY bridge/ ./bridge/

# 接入小智 MCP 接入点（WebSocket）用的桥接器依赖
RUN pip install --no-cache-dir "websockets>=13" "mcp>=2.3,<3"

ENV PYTHONUNBUFFERED=1 \
    GW_DATA=/data \
    GW_PORT=8766

VOLUME ["/data"]
EXPOSE 8766

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('GW_PORT','8766')+'/healthz',timeout=3)"

CMD ["python", "-u", "app.py"]

# fnmusic-gateway 单端口部署变量；复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# 这里只列 compose 会透传的变量；要调缓存/转码/歌词等其它参数，见 README「环境变量」，并自行加到 compose 的 environment。

# ---- 镜像 ----
GW_IMAGE=ghcr.io/kid941005/fnmusic-gateway:2.6.0
# 音源容器：默认轻量 WebUI 镜像；需要网易/洛雪改成 :latest 全量镜像
FNMUSIC_SOURCES_IMAGE=ghcr.io/kid941005/fnos_music_ext:musicdl-webui

# ---- 必填 ----
# 管理接口 / MCP / WebUI 的令牌：openssl rand -hex 24
GW_ADMIN_TOKEN=

# ---- WebUI ----
# 网关反代到音源容器管理台的地址（compose 默认值即可）
GW_WEBUI_URL=http://fnmusic-sources:8004

# ---- 飞牛音乐（可选，优先级最高；也可启动后在网页「网关设置」里填）----
GW_FNOS_BASE=
GW_FNOS_USER=
GW_FNOS_PASS=

# ---- 在线兜底音源 ----
# 类型@地址；默认指向内部音源容器
GW_FALLBACK_URLS=musicdl@http://fnmusic-sources:8001
# 本地下载目录在宿主机的位置（容器内固定 /music）
GW_MUSIC_DIR=./music

# ---- 小智 MCP 接入点（仅用桥接器时填；不用留空）----
MCP_ENDPOINT=

# ---- 音源容器 ----
MUSICDL_SOURCES=KuwoMusicClient,MiguMusicClient
MUSICDL_LIMIT_PER_SOURCE=10

# fnmusic-gateway 部署变量示例；复制为 .env 后按需填写。
# cp .env.example .env && chmod 600 .env

# ---- 镜像 ----
GW_IMAGE=ghcr.io/kid941005/fnmusic-gateway:2.0.0
# 全量版音源镜像；轻量版用 :musicdl，轻量+WebUI 用 :musicdl-webui
FNMUSIC_SOURCES_IMAGE=ghcr.io/kid941005/fnos_music_ext:latest

# ---- 网关 ----
GW_PUBLIC_PORT=8767
# 公网播放域名（Lucky 反代到 8767）；留空则用请求 Host
GW_PUBLIC_BASE=https://your-domain.example:59826
# 空=自动生成 /data/sign.key
GW_SIGN_SECRET=
GW_QUALITY_DEFAULT=standard
GW_TEE_SAVE=true
GW_LIBRARY_MAX_BYTES=0

# ---- 飞牛音乐账号 ----
FNMUSIC_BASE=http://192.168.50.100:59820
FNMUSIC_USER=KID
FNMUSIC_PASS=
FNMUSIC_DEVICE_ID=
# 仅在飞牛使用自签 HTTPS 时设为 1（默认校验证书）
FNMUSIC_INSECURE_TLS=

# ---- 多音源兜底 ----
# 类型@地址；全量版用 127.0.0.1:8768，轻量版用 fnmusic-sources:8001
GW_FALLBACK_URLS=musicdl@http://127.0.0.1:8768
# 在线歌曲保存到本地曲库的宿主机目录
GW_DOWNLOAD_DIR=/vol1/1000/Music
# 下载后触发飞牛扫描的命令，可留空
GW_LIBRARY_SCAN_CMD=

# ---- 小智 MCP 接入点（桥接器用；不用桥接器可留空）----
MCP_ENDPOINT=

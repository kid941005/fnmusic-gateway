# fnmusic-gateway 可选覆盖文件
#
# 所有环境变量及默认值都已写入 docker-compose.yml 的 environment 段。
# 本文件只负责敏感值/可选覆盖；不复制也可以，只要 GW_ADMIN_TOKEN 有值。
#   cp .env.example .env && chmod 600 .env

# ---- 必填 ----
GW_ADMIN_TOKEN=

# ---- 可选：飞牛音乐账号（也可启动后在 WebUI「网关设置」里填）----
# GW_FNOS_BASE=http://192.168.50.100:59820
# GW_FNOS_USER=admin
# GW_FNOS_PASS=
# GW_FNOS_DEVICE_ID=
# GW_FNOS_INSECURE_TLS=1

# ---- 可选：镜像 / 下载目录覆盖 ----
# GW_IMAGE=docker.io/kid941005/fnmusic-gateway:2.6.1
# FNMUSIC_SOURCES_IMAGE=ghcr.io/kid941005/fnos_music_ext:musicdl-webui
# GW_MUSIC_DIR=./music

# ---- 可选：小智 MCP 接入点（仅桥接器用）----
# MCP_ENDPOINT=
